
 @model PresseMots.Models.Story

@foreach (var item in Model.StoryTag.Tags)
{
    <span class="badge badge-secondary">
        @item.Name    &nbsp;&nbsp;
        <a class="badge badge-danger badge-pill"  asp-controller="StoryTags" asp-action="Delete" asp-route="item.id" >&nbsp;×&nbsp;</a>
    </span>

} 